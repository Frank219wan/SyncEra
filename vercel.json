{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/proxy.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/v1/:proxy_path*", "destination": "/api/proxy" },
    { "source": "/individual", "destination": "/index.html" },
    { "source": "/individual/((?!.*\\.).*)", "destination": "/index.html" },
    { "source": "/organization", "destination": "/index.html" },
    { "source": "/organization/((?!.*\\.).*)", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" }
  ]
}
