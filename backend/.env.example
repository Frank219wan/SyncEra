PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
MAX_CV_UPLOAD_BYTES=10485760
# On Vercel the code caps uploads at 3 MiB regardless of this local value.
DATABASE_PATH=./data/profiles.sqlite
# Hosted Vercel functions require an isolated PostgreSQL database; never expose this URL to Vite.
# Configure only in the protected Preview backend environment after database isolation is approved.
# PROFILE_STORE=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# B2 Organization is enabled automatically for local tests. Hosted Vercel
# deployments require this explicit flag, PostgreSQL, and migration 20261023_04.
# ENABLE_ORGANIZATION_MVP=1
# Optional: enable synthetic PDF/DOCX upload only after access and rate controls are approved.
# ENABLE_SYNTHETIC_UPLOAD=1
APPROVED_DATA_DIR=./data/approved
# Leave unset for the synthetic demo snapshot. Set only to a locally imported, reviewed snapshot ID.
# ACTIVE_SNAPSHOT_ID=snap_reviewed_id
# Leave unset for the labelled rule-only demo adapter. Tech v0.1.0 can be enabled after review.
# AI_ADAPTER_MODULE=futureproof_ai.futureproof_adapter
# Real MiniMax extraction for synthetic Preview inputs; keep the key server-side and never use VITE_*.
# AI_ADAPTER_MODULE=futureproof_ai.tencent_tokenhub_adapter
# TENCENT_TOKENHUB_API_KEY=
# TENCENT_TOKENHUB_MODEL=minimax-m3
# TENCENT_TOKENHUB_TIMEOUT_SECONDS=30
# TENCENT_TOKENHUB_MAX_TOKENS=800
# TENCENT_TOKENHUB_MAX_INPUT_CHARS=24000
# Career analysis is independently gated. Keep unset/0 until paid calls are separately authorized.
# Requires Vercel Preview, a server-side TokenHub key, and migration 002_career_analysis.sql.
# ENABLE_LIVE_CAREER_RECOMMENDATION=0
# Optional hybrid-RAG explanation. Ranking and gaps remain deterministic tech-v1.
# CAREER_RADAR_LLM_ENABLED=false
# CAREER_RADAR_MAX_TOKENS=1600
# Optional internal-only draft generation for reviewed named positions.
# POSITION_SKILL_DRAFTS_ENABLED=false

# Optional server-side database adapters. Each module exports the documented
# create_*_repository factory; leave unset to use the local demo repositories.
# PROFILE_REPOSITORY_MODULE=app.postgres_repositories
# MARKET_REPOSITORY_MODULE=app.postgres_repositories
# RESOURCE_REPOSITORY_MODULE=app.postgres_repositories
# Independent DOSM occupation-group visualization; does not supply job-level skills.
# DOSM_MARKET_RADAR_ENABLED=0
# P1 refresh remains disabled; no browser-facing secrets.
