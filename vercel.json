{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/proxy?proxy_path=:path*" },
    { "source": "/individual", "destination": "/index.html" },
    { "source": "/individual/((?!.*\\.).*)", "destination": "/index.html" },
    { "source": "/organization", "destination": "/index.html" },
    { "source": "/organization/((?!.*\\.).*)", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" }
  ]
}
