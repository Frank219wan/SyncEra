  "narrative": {
    "northStar": "Connected growth",
    "overview": "A calm botanical workspace connects career discovery to observable learning progress. Sage scenery, opaque ivory surfaces and deep green text preserve the approved natural, warm, quiet character. Photographic leaves frame the entry experience; bamboo and restrained botanical drawings connect learning progress to growth inside the workspace.\n\nThis record extracts the shipped implementation from `src/styles.css` and `src/components.tsx`. The locked choices in `docs/implementation-brief.md` supersede historical unresolved choices in the parent PRODUCT.md. The palette and serif/sans pairing are inherited decisions, not a new identity proposal.",
    "keyCharacteristics": [
      "Warm opaque surfaces on pale sage surroundings.",
      "Serif headings with practical multilingual sans-serif controls.",
      "Softly irregular entrance cards and regular workspace geometry.",
      "Subtle breathing motion, visible focus, and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Opaque Surface Rule",
        "body": "Reading and control surfaces remain opaque; the photographic atmosphere belongs behind them.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use serif for orientation and growth storytelling; use sans-serif for data entry, actions and evidence.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** preserve the approved sage, ivory and forest roles.",
      "**Do** pair serif orientation with sans-serif actions and evidence.",
      "**Do** retain keyboard focus and reduced-motion behavior.",
      "**Do** keep data and synthetic-demo disclosures readable."
    ],
    "donts": [
      "**Don't** replace opaque reading surfaces with translucent glass.",
      "**Don't** turn every workspace panel into an irregular entrance card.",
      "**Don't** use tiny metadata typography for primary reading.",
      "**Don't** translate user-entered content as part of language switching."
    ]
  }
